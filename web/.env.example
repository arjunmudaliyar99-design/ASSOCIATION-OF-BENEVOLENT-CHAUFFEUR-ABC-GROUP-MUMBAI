# Copy to .env.local for local use. In production set these in your host's environment settings.
NEXT_PUBLIC_SITE_URL=https://abcgroupmumbai.org

# Database. Local/VPS: a file. Vercel: a Turso database (libsql://...) plus its token.
DATABASE_URL=file:./data/abc.db
DATABASE_AUTH_TOKEN=

# Admin login sessions. Make a random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Razorpay dashboard > Account & Settings > API Keys (rzp_test_ keys until KYC is approved)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay dashboard > Webhooks > Add: https://<domain>/api/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=
