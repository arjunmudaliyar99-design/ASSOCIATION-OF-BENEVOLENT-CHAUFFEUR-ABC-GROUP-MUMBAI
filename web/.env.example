# Copy to .env.local for local dev. In production set these in Vercel > Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://abcgroupmumbai.org

# Razorpay dashboard > Account & Settings > API Keys (use rzp_test_ keys until KYC is approved)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay dashboard > Webhooks > Add: URL https://<domain>/api/razorpay/webhook, event payment.captured
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string
