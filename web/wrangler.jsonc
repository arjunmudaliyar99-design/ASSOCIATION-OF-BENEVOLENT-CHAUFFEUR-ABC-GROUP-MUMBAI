// Cloudflare Workers config for the website (built with @opennextjs/cloudflare).
// Secrets (DATABASE_AUTH_TOKEN, AUTH_SECRET, RAZORPAY_*) are set with `wrangler secret put`, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abcgroupmumbai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // The site's database: Cloudflare D1 in Asia-Pacific (no separate connection to open, so it's fast).
  "d1_databases": [{ "binding": "DB", "database_name": "abc-db", "database_id": "5710264b-eae0-4c91-a770-10661233d61a" }],
  "workers_dev": true,
  "routes": [
    { "pattern": "abcgroupmumbai.com", "custom_domain": true },
    { "pattern": "www.abcgroupmumbai.com", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://abcgroupmumbai.com",
    "DATABASE_URL": "libsql://abc-india-abcgroupmumbai.aws-ap-south-1.turso.io",
    "SCHEMA_READY": "1"
  }
}
